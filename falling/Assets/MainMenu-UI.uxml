<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="main-menu-root" style="flex-grow: 1; justify-content: center; align-items: center; background-color: rgba(8, 10, 18, 0.72);">
        <ui:VisualElement style="width: 460px; padding-top: 26px; padding-right: 26px; padding-bottom: 26px; padding-left: 26px; background-color: rgba(20, 25, 36, 0.88); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px;">
            <ui:Label name="highscore-label" text="HighScore: 0m" style="font-size: 30px; unity-font-style: bold; color: rgb(255, 255, 255); unity-text-align: middle-center; margin-bottom: 24px;"/>
            <ui:Button name="play-button" text="PLAY" enabled="true" style="height: 58px; font-size: 24px; unity-font-style: bold;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
